{
  "hosting": {
    "public": "webapp/dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "firebase-debug.log"
    ],
    "redirects": [
      {
        "source": "/.git/**",
        "destination": "/",
        "type": 301
      },
      {
        "source": "/firebase.json",
        "destination": "/",
        "type": 301
      },
      {
        "source": "/tests/**",
        "destination": "/",
        "type": 301
      },
      {
        "source": "/webapp/**",
        "destination": "/",
        "type": 301
      }
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}
